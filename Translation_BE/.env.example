# 配置模板：复制成 .env 后填真实值。.env 已被 .gitignore 忽略，不要提交。
#   cp .env.example .env

# 服务端口
PORT=8092

# 高德开放平台 → 应用管理 → 我的应用 → 添加 Key，服务平台选【Web服务】
AMAP_KEY=你的高德Web服务Key
# 上海 citycode / adcode（本项目固定同城规划，一般不用改）
AMAP_CITY=021
AMAP_ADCODE=310000

# PostgreSQL
PGUSER=postgres
PGPASSWORD=你的数据库密码
PGHOST=localhost
PGPORT=5432
PGDATABASE=Translation
